# LexAI — Environment Configuration
# Copy this file to .env.local and fill in your values.
# Never commit .env or .env.local — they are in .gitignore.

# ─── AI Configuration ──────────────────────────────────────────────────────────

# Google Gemini API key (required for live AI analysis)
# Get a key at: https://aistudio.google.com/app/apikey
# If not set, LexAI runs in DEMO MODE with realistic mock responses
GEMINI_API_KEY=

# Gemini model to use (default: gemini-1.5-flash)
# Supported stable models: gemini-1.5-flash, gemini-1.5-pro
# Do NOT use experimental models (gemini-2.0-flash-exp) — they produce inconsistent output
GEMINI_MODEL=gemini-1.5-flash

# ─── Storage ──────────────────────────────────────────────────────────────────

# Directory for the SQLite database file (default: ./data)
# On ephemeral-storage platforms (e.g. Vercel serverless), data will not persist across deployments.
# For persistence, mount a writable volume or use a managed database.
DB_DIR=./data

# Directory for uploaded document files (default: ./data/uploads)
# On ephemeral-storage platforms, uploads will not persist across deployments.
UPLOAD_DIR=./data/uploads

# ─── Upload Limits ────────────────────────────────────────────────────────────

# Maximum upload file size in megabytes (default: 10)
MAX_FILE_SIZE_MB=10

# ─── Server ───────────────────────────────────────────────────────────────────

# Port for the Next.js dev server (default: 3000)
PORT=3000

# Node environment (set automatically by Next.js/deployment platforms)
# NODE_ENV=production
