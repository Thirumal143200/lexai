{
  "name": "lexai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run postbuild",
    "postbuild": "node -e \"const fs=require('fs');const p=require('path');function cp(s,d){if(!fs.existsSync(s))return;fs.mkdirSync(d,{recursive:true});for(const f of fs.readdirSync(s)){const sp=p.join(s,f),dp=p.join(d,f);fs.statSync(sp).isDirectory()?cp(sp,dp):fs.copyFileSync(sp,dp)}}cp('public','.next/standalone/public');cp('.next/static','.next/standalone/.next/static');console.log('Copied static assets to standalone')\"",
    "start": "node server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "engines": {
    "node": ">=20.0.0 <27.0.0"
  },
  "dependencies": {
    "@google/genai": "^2.23.0",
    "@google/generative-ai": "^0.24.1",
    "better-sqlite3": "^13.0.3",
    "mammoth": "^1.12.3",
    "multer": "^2.4.0",
    "next": "16.3.5",
    "pdf-parse": "^2.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jest": "^30.5.1",
    "jest-environment-node": "^30.5.1",
    "ts-jest": "^29.4.12",
    "typescript": "^5"
  }
}
